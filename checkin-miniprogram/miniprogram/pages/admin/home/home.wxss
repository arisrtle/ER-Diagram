.ahead { display: flex; align-items: flex-end; gap: 20rpx; padding: 8rpx 40rpx 0 48rpx; }
.ahead-title { font-size: 76rpx; }
.ahead-count { font-size: 30rpx; font-weight: 600; color: var(--ink-2); margin-bottom: 10rpx; }
.avatar {
  margin-left: auto; position: relative; flex: none;
  width: 84rpx; height: 84rpx; margin-bottom: 4rpx;
  display: flex; align-items: center; justify-content: center;
  background: var(--celadon); color: var(--white); font-size: 34rpx; font-weight: 700;
  border-radius: 42rpx 34rpx 40rpx 32rpx / 36rpx 42rpx 34rpx 40rpx;
  transition: transform 0.15s;
}
.avatar.pressed { transform: scale(0.9); }
.badge {
  position: absolute; top: -8rpx; right: -8rpx; min-width: 36rpx; height: 36rpx; padding: 0 10rpx;
  border-radius: 18rpx; background: var(--rouge); color: var(--white);
  font-size: 22rpx; font-weight: 700; line-height: 36rpx; text-align: center;
  box-shadow: 0 0 0 4rpx var(--mist);
}

.pane { position: absolute; left: 0; right: 0; top: 0; bottom: 0; }
.pane.off { display: none; }

/* 底部卵石形切换栏 */
.dock {
  position: fixed; left: 50%; bottom: calc(env(safe-area-inset-bottom) + 36rpx); z-index: 50;
  transform: translateX(-50%);
  display: flex; gap: 8rpx; padding: 12rpx;
  background: var(--ink);
  border-radius: 68rpx 52rpx 72rpx 48rpx / 56rpx 68rpx 52rpx 64rpx;
  box-shadow: 0 32rpx 60rpx -32rpx rgba(19, 49, 46, 0.75);
}
.dock-btn {
  display: flex; align-items: center; gap: 12rpx; height: 96rpx; padding: 0 32rpx;
  color: rgba(255, 255, 255, 0.66); font-size: 28rpx; font-weight: 600; white-space: nowrap;
  border-radius: 52rpx 40rpx 48rpx 36rpx / 44rpx 52rpx 40rpx 48rpx;
  transition: background 0.25s, color 0.25s;
}
.dock-btn.on { background: var(--gold); color: var(--ink); }

/* 管理员抽屉 */
.admins { display: flex; flex-direction: column; }
.arow { display: flex; align-items: center; gap: 24rpx; padding: 20rpx 0; }
.av { width: 80rpx; height: 80rpx; border-radius: 50%; flex: none; background: var(--celadon); color: var(--white); font-size: 32rpx; font-weight: 700; display: flex; align-items: center; justify-content: center; }
.av.p { background: var(--gold-soft); color: var(--gold-ink); }
.arow-text { flex: 1; min-width: 0; display: flex; flex-direction: column; }
.arow-name { font-weight: 600; }
.acts { display: flex; gap: 12rpx; flex: none; }
