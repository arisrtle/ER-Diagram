<view class="screen">
  <nav-bar back title="{{id ? '编辑课程' : '新增课程'}}" />

  <scroll-view class="grow" scroll-y>
    <!-- 签到点位 -->
    <view class="map-box">
      <map
        wx:if="{{hasPoint}}"
        id="map"
        class="map"
        latitude="{{latitude}}"
        longitude="{{longitude}}"
        scale="{{scale}}"
        markers="{{markers}}"
        circles="{{circles}}"
        show-location
        enable-zoom
        enable-scroll
        bindtap="onMapTap"
      ></map>
      <view wx:else class="map-empty">
        <ic name="map" size="64" />
        <text class="sub">还没有选择签到点位</text>
      </view>
    </view>
    <view class="map-actions">
      <view class="pill soft sm peb3" hover-class="hover" bindtap="chooseOnMap"><ic name="pin" size="30" />在地图上选点</view>
      <view class="pill soft sm peb4" hover-class="hover" bindtap="useCurrent"><ic name="locate" size="30" />用当前位置</view>
    </view>
    <view wx:if="{{hasPoint}}" class="addr">
      <ic name="pin" size="26" />
      <text class="addr-t">{{address}}　<text class="num">{{coordText}}</text></text>
    </view>
    <view class="pad note map-tip">也可以直接点地图上的位置。学生在圆圈范围内才能签到。</view>

    <!-- 名称 -->
    <view class="pad form">
      <view class="field">
        <text class="field-label">课程名称</text>
        <input class="input compact peb3" placeholder="例如 数据库原理 第 5 周" placeholder-class="ph" maxlength="40" value="{{name}}" focus="{{nameFocus}}" bindinput="onName" />
      </view>
      <view class="field">
        <text class="field-label">备注（可选）</text>
        <input class="input compact peb4" placeholder="例如 教学楼 B 204，周二 3–4 节" placeholder-class="ph" maxlength="60" value="{{note}}" bindinput="onNote" />
      </view>
    </view>

    <!-- 范围 -->
    <view class="pad radius">
      <view class="radius-top">
        <text class="field-label">签到范围</text>
        <text class="radius-val num">{{radius}}<text class="radius-unit">米</text></text>
      </view>
      <slider
        class="slider"
        min="10"
        max="500"
        step="5"
        value="{{radius}}"
        activeColor="#2F7D6D"
        backgroundColor="#DCE6E1"
        block-size="26"
        block-color="#FFFFFF"
        bindchanging="onRadius"
        bindchange="onRadius"
      />
      <view class="presets">
        <view wx:for="{{presets}}" wx:key="*this" class="chip sm num {{radius === item ? 'on' : ''}}" data-v="{{item}}" bindtap="pickPreset">{{item}} 米</view>
      </view>
      <text class="note">默认 50 米。室内定位常有 10–30 米误差，范围太小会让坐在教室里的学生也签不上。</text>
    </view>

    <view class="space"></view>
  </scroll-view>

  <view class="foot safe-bottom">
    <view wx:if="{{id}}" class="link danger" hover-class="hover" bindtap="askDelete">删除课程</view>
    <view class="pill cel peb save {{saving ? 'is-disabled' : ''}}" hover-class="hover" bindtap="save">{{saving ? '正在保存' : (id ? '保存修改' : '创建课程')}}</view>
  </view>

  <app-sheet show="{{delSheet}}" locked="{{deleting}}" bind:close="closeDelete">
    <text class="h3">删除这门课程？</text>
    <text class="sub">「{{name}}」和它的全部签到记录会一起删除，无法恢复。需要留档请先在「记录」里导出 Excel。</text>
    <view class="row2">
      <view class="pill soft peb" hover-class="hover" bindtap="closeDelete">保留</view>
      <view class="pill danger peb2 {{deleting ? 'is-disabled' : ''}}" hover-class="hover" bindtap="remove">{{deleting ? '正在删除' : '删除课程'}}</view>
    </view>
  </app-sheet>

  <app-toast id="toast" />
</view>
