.map-box {
  margin: 12rpx 32rpx 0; height: 400rpx; overflow: hidden; background: #DCE7E1;
  border-radius: 60rpx 44rpx 68rpx 40rpx / 52rpx 60rpx 44rpx 56rpx;
  transform: translateZ(0);
}
.map { width: 100%; height: 100%; }
.map-empty { height: 100%; display: flex; flex-direction: column; align-items: center; justify-content: center; gap: 16rpx; color: var(--ink-3); }
.map-actions { display: flex; gap: 16rpx; padding: 20rpx 32rpx 0; }
.map-actions .pill { flex: 1; }
.addr { display: flex; align-items: center; gap: 10rpx; padding: 20rpx 48rpx 0; color: var(--ink-2); font-size: 25rpx; }
.addr-t { white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
.map-tip { display: block; margin-top: 8rpx; }

.form { display: flex; flex-direction: column; gap: 28rpx; margin-top: 40rpx; }

.radius { display: flex; flex-direction: column; gap: 16rpx; margin-top: 40rpx; }
.radius-top { display: flex; align-items: baseline; justify-content: space-between; }
.radius-val { font-size: 68rpx; font-weight: 800; line-height: 1; }
.radius-unit { font-family: var(--f-body); font-size: 30rpx; font-weight: 500; margin-left: 6rpx; }
.slider { margin: 8rpx 4rpx; }
.presets { display: flex; gap: 16rpx; flex-wrap: wrap; }

.space { height: 48rpx; }
.foot { display: flex; align-items: center; gap: 32rpx; padding-left: 40rpx; padding-right: 40rpx; padding-top: 20rpx; background: var(--mist); }
.save { flex: 1; }
.row2 { display: flex; gap: 20rpx; }
.row2 .pill { flex: 1; }
