.center { display: flex; align-items: center; justify-content: center; }

.who { display: flex; align-items: center; gap: 20rpx; padding: 0 40rpx 0 48rpx; }
.who-name { font-size: 44rpx; line-height: 1.2; font-weight: 700; }
.who-meta { color: var(--ink-2); font-size: 26rpx; flex: 1; min-width: 0; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
.who-out { flex: none; }
.who-no { margin-left: 16rpx; }

.chips { margin-top: 24rpx; white-space: nowrap; display: flex; flex-direction: row; }
.chips .chip { margin-right: 16rpx; }
.chips-end { flex: none; width: 48rpx; height: 2rpx; }
.chip-ok { width: 32rpx; height: 32rpx; border-radius: 50%; background: var(--gold); color: var(--ink); display: flex; align-items: center; justify-content: center; }

.place { display: flex; align-items: center; gap: 10rpx; padding: 24rpx 48rpx 0; color: var(--ink-2); font-size: 26rpx; }
.place-text { white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }

.radar-wrap { margin-top: 20rpx; }

.reading { display: flex; align-items: flex-end; justify-content: space-between; gap: 24rpx; margin-top: 8rpx; }
.reading-label { font-size: 26rpx; color: var(--ink-2); margin-bottom: 10rpx; }
.big { font-size: 120rpx; line-height: 0.9; font-weight: 800; letter-spacing: -0.03em; }
.big-unit { font-family: var(--f-body); font-size: 36rpx; font-weight: 500; letter-spacing: 0; margin-left: 8rpx; }
.meta { display: flex; flex-direction: column; align-items: flex-end; gap: 12rpx; }
.meta-line { display: flex; align-items: center; gap: 20rpx; }

.act { display: flex; flex-direction: column; align-items: center; gap: 20rpx; padding-left: 48rpx; padding-right: 48rpx; }
.hint { font-size: 26rpx; color: var(--ink-2); text-align: center; max-width: 560rpx; line-height: 1.5; }

/* 已签到：印章 */
.seal-wrap { position: relative; width: 296rpx; height: 296rpx; }
.seal {
  position: absolute; left: 0; top: 0; width: 296rpx; height: 296rpx; border-radius: 50%;
  background: var(--ink); color: var(--white);
  display: flex; flex-direction: column; align-items: center; justify-content: center; gap: 8rpx;
  transform: rotate(-4deg);
}
.seal::before { content: ""; position: absolute; left: 16rpx; top: 16rpx; right: 16rpx; bottom: 16rpx; border-radius: 50%; border: 3rpx dashed rgba(242, 183, 5, 0.7); }
.seal-t { font-size: 56rpx; line-height: 1; color: var(--gold); }
.seal-time { font-size: 44rpx; font-weight: 700; }
.seal.just { animation: stamp 0.6s cubic-bezier(0.2, 1.5, 0.4, 1) both; }
@keyframes stamp {
  0% { transform: scale(1.5) rotate(-14deg); opacity: 0; }
  60% { transform: scale(0.94) rotate(3deg); opacity: 1; }
  100% { transform: scale(1) rotate(-4deg); }
}
.burst { position: absolute; left: 0; top: 0; width: 296rpx; height: 296rpx; border-radius: 50%; border: 6rpx solid var(--gold); animation: burst 0.8s ease-out forwards; }
@keyframes burst { from { transform: scale(1); opacity: 1; } to { transform: scale(1.9); opacity: 0; } }

/* 本机已用 / 记录已处理 */
.used {
  width: 296rpx; height: 296rpx; border-radius: 50%;
  border: 4rpx solid var(--rouge); background: var(--rouge-soft); color: var(--rouge);
  display: flex; align-items: center; justify-content: center; text-align: center;
}
.used-t { font-size: 44rpx; line-height: 1.15; text-align: center; }

/* 定位权限 */
.perm { display: flex; flex-direction: column; align-items: center; gap: 20rpx; text-align: center; padding-bottom: 12rpx; }
.perm .pill { margin-top: 12rpx; }

/* 屏幕较矮（如 iPhone SE）时缩小范围图和按钮，页面仍可上下滚动 */
.page-scroll { height: auto; min-height: 100vh; overflow: visible; }
.compact .radar-wrap { transform: scale(0.8); margin-top: -28rpx; margin-bottom: -48rpx; }
.compact .act { transform: scale(0.88); transform-origin: 50% 100%; }
.compact .big { font-size: 104rpx; }
