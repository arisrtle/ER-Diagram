/**
 * 全局样式
 *
 * 视觉方向：签到范围画成同心圆，冷调青瓷灰绿为底；
 * 只有「在范围内 / 已签到」时出现藤黄色；按钮用不规则圆角的「卵石」形，不用规整矩形。
 * 字体：标题用得意黑（Smiley），数字和拉丁字母用 Bricolage Grotesque（Brico），
 * 中文正文跟随系统字体。两个字体都以子集形式内联在 styles/fonts.wxss（由 scripts/build_fonts.py 生成）。
 */
@import "styles/fonts.wxss";

page {
  /* 颜色 */
  --mist: #E9EFEC;      /* 页面底色 */
  --mist-2: #DCE6E1;    /* 次级面、禁用 */
  --paper: #F7FAF8;     /* 浮起的面：输入框、列表行 */
  --ink: #13312E;       /* 主文字 */
  --ink-2: #4E6A65;     /* 次要文字 */
  --ink-3: #7E958F;     /* 占位、说明 */
  --line: #C9D8D2;      /* 细线、圆环 */
  --celadon: #2F7D6D;   /* 主色 */
  --celadon-2: #1F5A4F;
  --gold: #F2B705;      /* 在范围内、已签到 */
  --gold-soft: #FCEBB0;
  --gold-ink: #6E5300;
  --rouge: #D9415B;     /* 超出范围、错误、删除 */
  --rouge-soft: #F8DCE1;
  --rouge-ink: #A42640;
  --white: #FFFFFF;

  /* 字体 */
  --f-display: "Smiley", "PingFang SC", "HarmonyOS Sans SC", "MiSans", "Microsoft YaHei", sans-serif;
  --f-num: "Brico", "PingFang SC", "HarmonyOS Sans SC", "Microsoft YaHei", sans-serif;
  --f-body: "Brico", -apple-system, "PingFang SC", "HarmonyOS Sans SC", "MiSans", "Microsoft YaHei", sans-serif;

  height: 100%;
  background: var(--mist);
  color: var(--ink);
  font-family: var(--f-body);
  font-size: 30rpx;
  line-height: 1.5;
}

view, text, button, input, textarea, scroll-view { box-sizing: border-box; }
button { margin: 0; padding: 0; line-height: inherit; font-family: inherit; background: transparent; border-radius: 0; }
button::after { display: none; }

/* ---------- 页面骨架 ---------- */
.screen { height: 100vh; display: flex; flex-direction: column; overflow: hidden; position: relative; }
.grow { flex: 1; min-height: 0; position: relative; }
.pad { padding: 0 48rpx; }
.safe-bottom { padding-bottom: calc(env(safe-area-inset-bottom) + 32rpx); }

/* ---------- 文字 ---------- */
.display { font-family: var(--f-display); font-weight: 400; letter-spacing: 0.01em; }
.h1 { font-family: var(--f-display); font-size: 80rpx; line-height: 1.04; }
.h2 { font-family: var(--f-display); font-size: 60rpx; line-height: 1.1; }
.h3 { font-family: var(--f-display); font-size: 52rpx; line-height: 1.1; }
.sub { color: var(--ink-2); font-size: 28rpx; line-height: 1.6; }
.note { color: var(--ink-3); font-size: 25rpx; }
.num { font-family: var(--f-num); font-variant-numeric: tabular-nums; }
.err-text { color: var(--rouge); font-size: 27rpx; line-height: 1.5; }

/* ---------- 卵石形状：不规则圆角 ---------- */
.peb  { border-radius: 76rpx 48rpx 84rpx 44rpx / 60rpx 68rpx 52rpx 72rpx; }
.peb2 { border-radius: 48rpx 80rpx 44rpx 88rpx / 68rpx 52rpx 76rpx 56rpx; }
.peb3 { border-radius: 40rpx 28rpx 44rpx 26rpx / 32rpx 40rpx 28rpx 36rpx; }
.peb4 { border-radius: 28rpx 40rpx 26rpx 44rpx / 36rpx 28rpx 40rpx 32rpx; }

/* ---------- 按钮 ---------- */
.pill {
  height: 112rpx; padding: 0 52rpx;
  display: flex; align-items: center; justify-content: center; gap: 16rpx;
  font-size: 32rpx; font-weight: 600;
  transition: transform 0.16s ease, opacity 0.2s;
}
.pill.hover { transform: scale(0.97); opacity: 0.9; }
.pill.sm { height: 80rpx; padding: 0 32rpx; font-size: 28rpx; gap: 10rpx; }
.pill.ink { background: var(--ink); color: var(--white); }
.pill.cel { background: var(--celadon); color: var(--white); }
.pill.soft { background: var(--paper); color: var(--ink); }
.pill.gold { background: var(--gold); color: var(--ink); }
.pill.danger { background: var(--rouge); color: var(--white); }
.pill.is-disabled { background: var(--mist-2) !important; color: var(--ink-3) !important; }

/* 文字按钮：下方一道手绘般的弧线 */
.link { display: inline-flex; align-items: center; gap: 8rpx; position: relative; padding: 8rpx 0 16rpx; font-size: 28rpx; font-weight: 600; color: var(--celadon-2); }
.link::after { content: ""; position: absolute; left: 0; right: 0; bottom: 4rpx; height: 12rpx; border-bottom: 4rpx solid currentColor; border-radius: 0 0 50% 50%; opacity: 0.5; }
.link.danger { color: var(--rouge); }
.link.hover { opacity: 0.6; }

/* ---------- 表单 ---------- */
.field { display: flex; flex-direction: column; gap: 16rpx; }
.field-label { font-size: 28rpx; color: var(--ink-2); font-weight: 500; }
.input {
  height: 116rpx; padding: 0 40rpx; width: 100%;
  background: var(--paper); border: 3rpx solid transparent;
  font-size: 36rpx; color: var(--ink);
}
.input.compact { height: 100rpx; font-size: 32rpx; padding: 0 32rpx; }
.input.digits { font-family: var(--f-num); font-weight: 600; letter-spacing: 0.04em; }
.input.focus { border-color: var(--celadon); }
.input.err { border-color: var(--rouge); }
.input.readonly { background: var(--mist-2); display: flex; align-items: center; }
.ph { color: var(--ink-3); font-weight: 400; letter-spacing: 0; font-family: var(--f-body); }

/* ---------- 标签 ---------- */
.chip {
  flex: none; height: 76rpx; padding: 0 32rpx;
  display: inline-flex; align-items: center; gap: 12rpx;
  background: var(--paper); color: var(--ink);
  font-size: 28rpx; font-weight: 500; white-space: nowrap;
  border-radius: 38rpx 26rpx 36rpx 24rpx / 30rpx 36rpx 26rpx 34rpx;
  transition: background 0.2s, color 0.2s;
}
.chip.on { background: var(--ink); color: var(--white); }
.chip.sm { height: 68rpx; padding: 0 26rpx; font-size: 26rpx; }
.chip .count { font-family: var(--f-num); font-weight: 600; opacity: 0.66; }

.tag { display: inline-flex; align-items: center; gap: 8rpx; padding: 12rpx 24rpx; font-size: 26rpx; font-weight: 600; }
.tag.in { background: var(--gold-soft); color: var(--gold-ink); }
.tag.out { background: var(--rouge-soft); color: var(--rouge-ink); }
.tag.wait { background: var(--mist-2); color: var(--ink-2); }

/* ---------- 空状态 / 加载 ---------- */
.empty { display: flex; flex-direction: column; align-items: center; gap: 20rpx; padding: 80rpx 64rpx; text-align: center; }
.empty .ring { width: 200rpx; height: 200rpx; border-radius: 50%; border: 3rpx dashed var(--celadon); display: flex; align-items: center; justify-content: center; }
.empty .ring .dot { width: 28rpx; height: 28rpx; border-radius: 50%; background: var(--gold); box-shadow: 0 0 0 8rpx var(--white); }
.loading-dot { width: 20rpx; height: 20rpx; border-radius: 50%; background: var(--celadon); animation: breathe 1.1s ease-in-out infinite; }
@keyframes breathe { 0%, 100% { transform: scale(0.6); opacity: 0.5; } 50% { transform: scale(1); opacity: 1; } }
