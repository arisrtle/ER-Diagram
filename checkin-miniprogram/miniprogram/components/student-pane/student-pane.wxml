<view class="wrap">
  <view class="tools">
    <view class="pill ink sm peb {{importing ? 'is-disabled' : ''}}" hover-class="hover" bindtap="chooseFile"><ic name="upload" size="32" />导入名单</view>
    <view class="pill soft sm peb2 {{templating ? 'is-disabled' : ''}}" hover-class="hover" bindtap="downloadTemplate"><ic name="download" size="32" />下载模板</view>
  </view>

  <view class="search peb3">
    <ic name="search" size="32" />
    <input class="search-input" placeholder="搜索学号或姓名" placeholder-class="ph" value="{{keyword}}" confirm-type="search" bindinput="onKeyword" />
    <view wx:if="{{keyword}}" class="search-clear" bindtap="clearKeyword"><ic name="close" size="28" /></view>
  </view>

  <scroll-view class="filters" scroll-x enable-flex show-scrollbar="{{false}}">
    <view class="filters-pad"></view>
    <view class="chip sm {{className === '' ? 'on' : ''}}" data-name="" bindtap="pickClass">全部 <text class="count">{{grandTotal}}</text></view>
    <view wx:for="{{classes}}" wx:key="name" class="chip sm {{className === item.name ? 'on' : ''}}" data-name="{{item.name}}" bindtap="pickClass">{{item.name}} <text class="count">{{item.count}}</text></view>
    <view class="filters-pad"></view>
  </scroll-view>

  <scroll-view
    class="list"
    scroll-y
    refresher-enabled
    refresher-background="#E9EFEC"
    refresher-triggered="{{refreshing}}"
    bindrefresherrefresh="onRefresh"
    bindscrolltolower="loadMore"
    lower-threshold="200"
  >
    <view wx:if="{{loading}}" class="center"><view class="loading-dot"></view></view>

    <view wx:elif="{{error && !rows.length}}" class="empty">
      <text class="sub">{{error}}</text>
      <view class="pill soft sm peb" hover-class="hover" bindtap="load">重新加载</view>
    </view>

    <view wx:elif="{{!rows.length && !keyword && !className}}" class="empty">
      <view class="ring"><view class="dot"></view></view>
      <text class="h3">还没有学生</text>
      <text class="sub">把包含「班级」「姓名」「学号」三列的 Excel 发到微信聊天里，再点「导入名单」选择它。不确定格式可以先下载模板。</text>
    </view>

    <view wx:elif="{{!rows.length}}" class="empty">
      <text class="sub">没有找到匹配的学生。</text>
    </view>

    <block wx:else>
      <block wx:for="{{rows}}" wx:key="studentNo">
        <view wx:if="{{item.head}}" class="grp">
          <text class="grp-t">{{item.className}}</text>
          <text class="grp-n num">{{item.classCount}} 人</text>
        </view>
        <view class="srow">
          <view class="av">{{item.initial}}</view>
          <text class="sname">{{item.name}}</text>
          <text class="sno num">{{item.studentNo}}</text>
        </view>
      </block>
      <view class="more">
        <view wx:if="{{loadingMore}}" class="loading-dot"></view>
        <text wx:elif="{{!hasMore}}" class="note">共 {{total}} 人</text>
      </view>
    </block>
    <view class="bottom-space"></view>
  </scroll-view>
</view>

<!-- 导入结果 -->
<app-sheet show="{{resultSheet}}" locked="{{importing}}" bind:close="closeResult">
  <block wx:if="{{importing}}">
    <text class="h3">正在导入</text>
    <text class="sub">读取班级、姓名、学号三列，已存在的学号会按新名单更新。</text>
    <view class="progress"><view class="progress-bar"></view></view>
  </block>
  <block wx:elif="{{result.error}}">
    <text class="h3">没有导入</text>
    <text class="sub">{{result.fileName}}：{{result.error}}</text>
    <view wx:if="{{result.problems.length}}" class="probs">
      <view wx:for="{{result.problems}}" wx:key="row" class="prob"><text class="prob-row num">第 {{item.row}} 行</text>{{item.reason}}</view>
    </view>
    <view class="pill ink peb" hover-class="hover" bindtap="closeResult">知道了</view>
  </block>
  <block wx:elif="{{result}}">
    <text class="h3">导入完成</text>
    <view class="stats">
      <view class="stat"><text class="stat-n num">{{result.added}}</text><text class="note">新增</text></view>
      <view class="stat"><text class="stat-n num">{{result.updated}}</text><text class="note">更新</text></view>
      <view class="stat"><text class="stat-n num {{result.skipped ? 'bad' : ''}}">{{result.skipped}}</text><text class="note">跳过</text></view>
    </view>
    <view wx:if="{{result.problems.length}}" class="probs">
      <view wx:for="{{result.problems}}" wx:key="row" class="prob"><text class="prob-row num">第 {{item.row}} 行</text>{{item.reason}}</view>
    </view>
    <text class="sub">{{result.skipped ? '跳过的行改好后可以再导入一次，已导入的学生不会重复。' : '名单已更新，学生现在可以用学号和姓名登录。'}}</text>
    <view class="pill ink peb" hover-class="hover" bindtap="closeResult">完成</view>
  </block>
</app-sheet>
