:host { display: block; height: 100%; }
.wrap { height: 100%; display: flex; flex-direction: column; }
.center { display: flex; justify-content: center; padding-top: 120rpx; }

.tools { display: flex; gap: 16rpx; padding: 24rpx 32rpx 0; }
.search {
  margin: 24rpx 32rpx 0; height: 92rpx; padding: 0 28rpx;
  display: flex; align-items: center; gap: 18rpx;
  background: var(--paper); color: var(--ink-3);
}
.search-input { flex: 1; height: 92rpx; font-size: 29rpx; color: var(--ink); }
.search-clear { padding: 12rpx; color: var(--ink-3); }

.filters { margin-top: 20rpx; white-space: nowrap; display: flex; flex-direction: row; flex: none; }
.filters .chip { margin-right: 14rpx; }
.filters-pad { flex: none; width: 32rpx; height: 2rpx; }

.list { flex: 1; min-height: 0; margin-top: 8rpx; }
.grp { display: flex; align-items: baseline; gap: 14rpx; padding: 32rpx 48rpx 10rpx; font-size: 30rpx; font-weight: 700; color: var(--ink-2); }
.grp-t { letter-spacing: 0.02em; }
.grp-n { font-size: 25rpx; color: var(--ink-3); font-weight: 600; }
.srow { display: flex; align-items: center; gap: 24rpx; padding: 20rpx 48rpx; }
.av { width: 68rpx; height: 68rpx; border-radius: 50%; flex: none; background: var(--mist-2); color: var(--celadon-2); font-size: 28rpx; font-weight: 700; display: flex; align-items: center; justify-content: center; }
.sname { font-weight: 600; flex: 1; min-width: 0; }
.sno { color: var(--ink-2); font-size: 28rpx; letter-spacing: 0.03em; }
.more { display: flex; justify-content: center; padding: 28rpx 0; }
.bottom-space { height: calc(env(safe-area-inset-bottom) + 220rpx); }

/* 导入结果 */
.progress { height: 16rpx; border-radius: 8rpx; background: var(--mist-2); overflow: hidden; }
.progress-bar { height: 100%; width: 40%; border-radius: 8rpx; background: var(--celadon); animation: slide 1.2s ease-in-out infinite; }
@keyframes slide { from { transform: translateX(-100%); } to { transform: translateX(250%); } }
.stats { display: flex; gap: 48rpx; }
.stat { display: flex; flex-direction: column; }
.stat-n { font-size: 76rpx; font-weight: 800; line-height: 1; }
.stat-n.bad { color: var(--rouge); }
.probs { display: flex; flex-direction: column; gap: 12rpx; max-height: 360rpx; overflow-y: auto; font-size: 27rpx; color: var(--ink-2); }
.prob-row { color: var(--rouge); font-weight: 600; margin-right: 12rpx; }
